{
    "name": "skunkwerkx/hyperuuid-dev",
    "description": "Development harness for the hyperuuid PHP extension",
    "type": "library",
    "keywords": ["uuid", "guid", "rfc9562", "uuidv4", "uuidv5", "uuidv7", "rust"],
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Buvinghausen"
        }
    ],
    "homepage": "https://github.com/SkunkWerkx/HyperUuid",
    "support": {
        "issues": "https://github.com/SkunkWerkx/HyperUuid/issues",
        "source": "https://github.com/SkunkWerkx/HyperUuid"
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpbench/phpbench": "^1.7",
        "ramsey/uuid": "^4.9",
        "squizlabs/php_codesniffer": "^3.10 || ^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "HyperUuid\\Tests\\": "tests/",
            "HyperUuid\\Bench\\": "bench/"
        }
    },
    "scripts": {
        "test": "@php tools/run-tests.php",
        "bench": "@php tools/run-bench.php"
    }
}
