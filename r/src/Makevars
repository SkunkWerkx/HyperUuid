# Unix build: cargo builds the rcore static library (src/rust) and R links it into
# hyperuuid.so. Makevars.win differs only in passing --target $(TARGET), which makes Cargo
# write to $(TARGET_DIR)/$(TARGET)/release; this file passes no --target, so LIBDIR here is
# $(TARGET_DIR)/release. Keep the two LIBDIRs different. CARGO_HOME stays under src/ for the
# build and is removed with the target.
TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/release
STATLIB = $(LIBDIR)/librcore.a
PKG_LIBS = -L$(LIBDIR) -lrcore
CARGO_HOME_DIR = $(CURDIR)/.cargo

all: $(SHLIB) rust_clean

$(SHLIB): $(STATLIB)

$(STATLIB):
	if [ -f rust/vendor.tar.xz ]; then \
	  tar xf rust/vendor.tar.xz -C rust && mkdir -p $(CARGO_HOME_DIR) && \
	  cp rust/vendor-config.toml $(CARGO_HOME_DIR)/config.toml && OFFLINE=--offline; \
	else OFFLINE=; fi; \
	export CARGO_HOME=$(CARGO_HOME_DIR); export PATH="$(PATH):$(HOME)/.cargo/bin"; \
	rustc --version; \
	cargo build -j 2 --lib --release $$OFFLINE --manifest-path rust/Cargo.toml --target-dir $(TARGET_DIR)

rust_clean: $(SHLIB)
	rm -rf $(STATLIB) $(CARGO_HOME_DIR) rust/vendor $(TARGET_DIR)
