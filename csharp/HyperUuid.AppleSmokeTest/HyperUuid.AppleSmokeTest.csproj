<Project Sdk="Microsoft.NET.Sdk">

  <!-- The package on iOS and Mac Catalyst, as an app: the same SmokeTest.Run() the Native AOT smoke
       test runs, crossing every native entry point, built for the two platforms where the
       core is linked into the app's executable and reached as "__Internal". It needs a Mac
       with Xcode and the ios and maccatalyst workloads, so it is not in HyperUuid.slnx,
       which every other leg builds; CI's test-apple-mobile job builds it three ways (Mac
       Catalyst, run as a process; the iOS simulator, installed and launched; an iOS device,
       linked and inspected, since no runner has one). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationId>io.github.skunkwerkx.hyperuuid.applesmoketest</ApplicationId>
    <ApplicationTitle>HyperUuid smoke test</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The managed-static registrar on Mac Catalyst, which was the default there until .NET 11
       RC1 made it trimmable-static for every CoreCLR app. With trimmable-static, the RC1
       Release app aborts before Main: xamarin_bridge_call_runtime_initialize fails to create
       its delegate with 0x80070002 (file not found). Nothing here is HyperUuid's; lift this
       once a .NET 11 workload runs the default. The SDK's props, read before this file, have
       already turned PrepareAssemblies and PostProcessAssemblies on for trimmable-static, so
       they are turned back off: the SDK leaves them off for an app on managed-static. -->
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-maccatalyst'))">
    <Registrar>managed-static</Registrar>
    <PrepareAssemblies>false</PrepareAssemblies>
    <PostProcessAssemblies>false</PostProcessAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../HyperUuid.AotSmokeTest/Program.cs" Link="Program.cs" />
    <Compile Include="../HyperUuid.AotSmokeTest/SmokeTest.cs" Link="SmokeTest.cs" />
    <ProjectReference Include="../HyperUuid/HyperUuid.csproj" />
  </ItemGroup>

  <!-- By hand, for the reason HyperUuid.AotSmokeTest gives: a project reference gets none of
       a NuGet package's build/ imports, and this is the project that proves the branch of
       that file a .NET iOS or Mac Catalyst consumer takes. The archive it links is
       csharp/HyperUuid/staticlibs/{rid}/, staged from the static-libs artifact. -->
  <Import Project="../HyperUuid/build/net11.0/HyperUuid.targets" />

  <!-- UIKit, by hand, because this app never touches it. From .NET 11 the SDK links only the
       frameworks the trimmer sees the app use, and the runtime's own libxamarin still
       references UIApplicationDidReceiveMemoryWarningNotification, so a Release build that
       uses no UIKit type fails its native link on that symbol. Every real iOS or Mac Catalyst
       app uses UIKit, so the package itself does not ask for it; only this test does. -->
  <ItemGroup Condition="'$(_HyperUuidAppleMobile)' == 'true'">
    <NativeReference Update="$(_HyperUuidAppleMobileLibrary)" Frameworks="UIKit" />
  </ItemGroup>

</Project>
