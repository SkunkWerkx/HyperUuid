<Project>
  <!-- Auto-imported into every consuming project via NuGet's build/{tfm}/{PackageId}.targets
       convention (and, through buildTransitive/{tfm}/, into projects that reach this package
       through another project's reference) — a .targets file (not .props) specifically because it needs
       $(RuntimeIdentifier) already resolved, which for a Blazor WebAssembly project only
       happens after that project's own Sdk.targets import; a .props file (imported before the
       project body) would run too early to see it.

       This is the piece that makes WASM support genuinely zero-effort for a consumer: without
       it, NuGet's runtimes/browser-wasm/nativeassets/{tfm}/ package convention is real (see
       NuGet.Client's ManagedCodeConventions.cs — the "NativeLibraries" PatternSet), and the
       WASM SDK's own WasmApp.Common.targets really does auto-promote any @(NativeLibrary) item
       into @(NativeFileReference) — but restore doesn't actually populate @(NativeLibrary) from
       a plain PackageReference's nativeassets folder the way it does runtimes/{rid}/native/ for
       ordinary P/Invoke. Without this file, the browser-wasm build succeeds but throws
       DllNotFoundException("*") at runtime because the native code never got linked in at all.

       The NativeFileReference is the whole wiring. The SDK scans every assembly's P/Invokes
       and generates a pinvoke table that calls each native function by symbol, so the link
       itself resolves them against the archive: with the archive missing, wasm-ld fails with an
       undefined symbol per entry point, and with it present LibraryImport("*") reaches each one
       through that table. No @(EmccExportedFunction) list is needed, because "*" resolution
       does not need the Emscripten export: HyperUuid.WasmSmokeTest calls all thirteen entry
       points without one on .NET SDK 11.0.100-rc.2, and fails at the link with the archive
       unlinked. Leaving it out also keeps uuid_variant clear of Emscripten's libuuid
       JavaScript library (src/lib/libuuid.js), which defines a stub of that name and takes
       over the export whenever it is listed.

       Two frameworks, one file. The package carries lib/net10.0/ and lib/net11.0/, and this
       file sits once under build/net10.0/ (with buildTransitive/net10.0/'s copy beside it):
       NuGet picks the nearest build/{tfm}/ folder, and net10.0 is the nearest one for both
       net10.0 and net11.0 projects, so there is no build/net11.0/ copy to keep in step.

       On .NET 10 the file serves Windows, Linux and macOS, framework-dependent or Native AOT,
       and refuses the platforms that need .NET 11 with HYPERUUID003 (the gate below): Blazor
       WebAssembly, Android, iOS and Mac Catalyst. The gate reads $(TargetFramework) and
       $(RuntimeIdentifier), not $(TargetFrameworkVersion) or $(TargetPlatformIdentifier): the
       four projects that import this file by hand do it in the project body, before the SDK
       has set those two, and they are empty there (a NuGet import runs after them). The
       TargetFramework functions give the same answer in both places. It hooks
       _CheckForInvalidConfigurationAndPlatform so that it speaks first, ahead of the Xcode
       and JDK checks the platform SDKs run, which would otherwise answer with their own
       message. Every other block below stands aside when the gate fires, so a refused build
       reports one diagnostic.

       The wasm archive stays in nativeassets/net11.0/: the path below names it directly, so
       the spelling is a folder name, not something NuGet selects by, and the only toolchain
       that links it is .NET 11's. -->
  <!-- HYPERUUID003: the platforms .NET 10 cannot serve. Evaluated here, at the top, so every
       block below can stand aside on _HyperUuidNet10Unsupported. Windows desktop
       (net10.0-windows) and net10.0-macos are not matched and build as before. -->
  <PropertyGroup Condition="'$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' == '.NETCoreApp' And $([MSBuild]::VersionLessThan($([MSBuild]::GetTargetFrameworkVersion($(TargetFramework))), '11.0'))">
    <_HyperUuidNet10Platform>$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))</_HyperUuidNet10Platform>
    <_HyperUuidNet10Unsupported Condition="'$(RuntimeIdentifier)' == 'browser-wasm' Or '$(_HyperUuidNet10Platform)' == 'browser'">Blazor WebAssembly</_HyperUuidNet10Unsupported>
    <_HyperUuidNet10Unsupported Condition="'$(_HyperUuidNet10Unsupported)' == '' And '$(_HyperUuidNet10Platform)' == 'android'">Android</_HyperUuidNet10Unsupported>
    <_HyperUuidNet10Unsupported Condition="'$(_HyperUuidNet10Unsupported)' == '' And '$(_HyperUuidNet10Platform)' == 'ios'">iOS</_HyperUuidNet10Unsupported>
    <_HyperUuidNet10Unsupported Condition="'$(_HyperUuidNet10Unsupported)' == '' And '$(_HyperUuidNet10Platform)' == 'maccatalyst'">Mac Catalyst</_HyperUuidNet10Unsupported>
    <_HyperUuidNet10Tfm Condition="'$(_HyperUuidNet10Unsupported)' == 'Blazor WebAssembly'">net11.0</_HyperUuidNet10Tfm>
    <_HyperUuidNet10Tfm Condition="'$(_HyperUuidNet10Unsupported)' == 'Android'">net11.0-android</_HyperUuidNet10Tfm>
    <_HyperUuidNet10Tfm Condition="'$(_HyperUuidNet10Unsupported)' == 'iOS'">net11.0-ios</_HyperUuidNet10Tfm>
    <_HyperUuidNet10Tfm Condition="'$(_HyperUuidNet10Unsupported)' == 'Mac Catalyst'">net11.0-maccatalyst</_HyperUuidNet10Tfm>
    <_HyperUuidNet10Suffix Condition="'$(_HyperUuidNet10Unsupported)' == 'Blazor WebAssembly'"> .NET 10's WebAssembly toolchain cannot link HyperUuid's native core: https://github.com/dotnet/runtime/issues/132858.</_HyperUuidNet10Suffix>
  </PropertyGroup>

  <Target Name="_HyperUuidErrorUnsupportedNet10Platform"
          BeforeTargets="_CheckForInvalidConfigurationAndPlatform"
          Condition="'$(_HyperUuidNet10Unsupported)' != ''">
    <Error Code="HYPERUUID003"
           Text="HyperUuid supports .NET 10 on Windows, Linux and macOS, framework-dependent or Native AOT. $(_HyperUuidNet10Unsupported) needs .NET 11 or later: target $(_HyperUuidNet10Tfm).$(_HyperUuidNet10Suffix)" />
  </Target>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' And '$(_HyperUuidNet10Unsupported)' == ''">
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../runtimes/browser-wasm/nativeassets/net11.0/libhyperuuid.a" />
  </ItemGroup>

  <!-- The link above happens only where the wasm-tools workload is installed. Without it the
       SDK never relinks the runtime: @(NativeFileReference) is skipped with nothing louder
       than the SDK's own warning, the publish succeeds, and the app ships the stock
       dotnet.native.wasm with no uuid_* symbols in it. NETSDK1147 does not fire for this,
       and setting WasmBuildNative from here cannot make it: the workload manifest decides
       whether the workload is needed before NuGet's package targets are imported.
       WasmNativeWorkloadAvailable is settled by then, so the check reads it directly and
       stops the build. An app that gates on UuidGenerator.IsAvailable and keeps a managed
       fallback can set HyperUuidRequireWasmWorkload to false. HyperCast's package carries
       the same check. -->
  <Target Name="_HyperUuidErrorWasmWorkloadMissing"
          BeforeTargets="BeforeBuild"
          Condition="'$(RuntimeIdentifier)' == 'browser-wasm' And '$(WasmNativeWorkloadAvailable)' != 'true' And '$(HyperUuidRequireWasmWorkload)' != 'false' And '$(_HyperUuidNet10Unsupported)' == ''">
    <Error Code="HYPERUUID002"
           Text="HyperUuid's WebAssembly support links its native core into the runtime, which needs the wasm-tools workload, and it is not installed. Without it the publish succeeds but the app has no uuid_* symbols, UuidGenerator.IsAvailable is false in the browser and every generator call throws. Run 'dotnet workload install wasm-tools', or set HyperUuidRequireWasmWorkload to false if the app keeps a managed fallback." />
  </Target>

  <!-- .NET 11 and later link browser-wasm with the new (exnref) exception-handling encoding,
       while Rust's precompiled core and compiler_builtins inside the emscripten staticlib use
       the legacy one (building the staticlib without std does not change that: the browser
       refuses the module without the pass). The link succeeds and the SDK's wasm-opt passes the
       mix through, then the browser refuses to compile the module: "module uses a mix of
       legacy and new exception handling instructions". Binaryen's translate-to-exnref pass
       rewrites the legacy instructions into the new encoding so the module is uniform.
       Appended to the SDK's own post-link wasm-opt step through @(WasmOptConfigurationFlags).

       Exclude names the item list itself, so the flag is added once however many packages
       ask for it: an app that references both HyperUuid and HyperCast imports both files,
       and without this wasm-opt was handed the pass twice. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' And '$(_HyperUuidNet10Unsupported)' == ''">
    <WasmOptConfigurationFlags Include="--translate-to-exnref" Exclude="@(WasmOptConfigurationFlags)" />
  </ItemGroup>

  <!-- The archive is linked by the path above, and nothing else is supposed to touch it. But
       restore resolves runtimes/browser-wasm/nativeassets/ as a copy-local native asset for
       this RID, so without this the 3 MB archive was copied into bin/ and the publish root of
       every Blazor WebAssembly consumer, never served and never read. Taken back out of
       @(NativeCopyLocalItems), which is where restore puts it, before anything copies it. -->
  <Target Name="_HyperUuidDropWasmArchiveFromCopyLocal"
          AfterTargets="ResolvePackageAssets"
          Condition="'$(RuntimeIdentifier)' == 'browser-wasm' And '$(_HyperUuidNet10Unsupported)' == ''">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'HyperUuid' And '%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension)' == 'libhyperuuid.a'" />
    </ItemGroup>
  </Target>

  <!-- iOS and Mac Catalyst: link the core in, always.

       An app on these platforms has no runtimes/{rid}/native/ to load a library from: the
       .NET SDK for them links native code into the app's own executable, and a P/Invoke
       reaches it under the library name "__Internal" (UuidGenerator.cs declares every entry
       point a third time against that name, picked by OperatingSystem.IsIOS(), which is true
       on Mac Catalyst too). NativeReference with Kind=Static is the item that SDK links, the
       same one a binding project uses, and it is the SDK's own native link that consumes it
       whether the app is compiled by Mono's AOT compiler, runs interpreted, or is published
       with Native AOT. So this is one branch for all three, and the Native AOT block below
       stands aside for these RIDs: its DirectPInvoke and NativeLibrary items are for ILC's
       own link, which is not the one that runs here.

       The archives are the same no_std static libraries, in staticlibs/{rid}/ for
       ios-arm64, iossimulator-arm64, maccatalyst-arm64 and maccatalyst-x64. A universal Mac
       Catalyst app (RuntimeIdentifiers with both) is built once per RID and merged by the
       SDK, and each of those inner builds evaluates this with its own RuntimeIdentifier. An
       RID with no archive here (iossimulator-x64, tvOS) gets nothing, and the app fails at
       its native link on the undefined uuid_* symbols: at build time, not at run time. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' And '$(_HyperUuidNet10Unsupported)' == ''">
    <_HyperUuidAppleMobile Condition="$(RuntimeIdentifier.StartsWith('ios-')) Or $(RuntimeIdentifier.StartsWith('iossimulator-')) Or $(RuntimeIdentifier.StartsWith('maccatalyst-'))">true</_HyperUuidAppleMobile>
    <_HyperUuidAppleMobileLibrary Condition="'$(_HyperUuidAppleMobile)' == 'true'">$(MSBuildThisFileDirectory)../../staticlibs/$(RuntimeIdentifier)/libhyperuuid.a</_HyperUuidAppleMobileLibrary>
  </PropertyGroup>

  <ItemGroup Condition="'$(_HyperUuidAppleMobile)' == 'true' And Exists('$(_HyperUuidAppleMobileLibrary)') And '$(_HyperUuidNet10Unsupported)' == ''">
    <NativeReference Include="$(_HyperUuidAppleMobileLibrary)" Kind="Static" />
  </ItemGroup>

  <!-- Native AOT: link the core in.

       Without this, a Native AOT publish produces an executable with libhyperuuid.so (or the
       .dylib, or the .dll) sitting beside it, opened on first use like any other P/Invoke. Here it is
       linked into the executable instead: DirectPInvoke tells the AOT compiler to bind every
       import from "hyperuuid" as a direct call to a symbol the linker must resolve, and
       NativeLibrary hands the linker the archive that defines them. The result is one file,
       and calls that are plain calls, with no lazy binding stub in front of them.

       The archives are in staticlibs/{rid}/, one per RID the package carries a shared
       library for, built without Rust's standard library so that this package and
       HyperCast's can both be linked into one executable (the same collision, and the same
       fix, as the Blazor WebAssembly archive above).

       Presence decides. Where the package has no archive for the RID being published — a
       RID it has never heard of, or a package built before these existed — nothing here
       applies and the publish loads the shared library exactly as it always did. Setting
       HyperUuidStaticLink to false asks for that on purpose.

       Not for browser-wasm or for iOS and Mac Catalyst, which have their own wiring above,
       and not for anything but an AOT publish: a JIT process cannot link an archive, so it
       still loads the shared library. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' != '' And '$(RuntimeIdentifier)' != 'browser-wasm' And '$(_HyperUuidAppleMobile)' != 'true' And '$(HyperUuidStaticLink)' != 'false' And '$(_HyperUuidNet10Unsupported)' == ''">
    <_HyperUuidStaticLibrary Condition="$(RuntimeIdentifier.StartsWith('win'))">$(MSBuildThisFileDirectory)../../staticlibs/$(RuntimeIdentifier)/hyperuuid.lib</_HyperUuidStaticLibrary>
    <_HyperUuidStaticLibrary Condition="!$(RuntimeIdentifier.StartsWith('win'))">$(MSBuildThisFileDirectory)../../staticlibs/$(RuntimeIdentifier)/libhyperuuid.a</_HyperUuidStaticLibrary>
    <_HyperUuidStaticLibrary Condition="!Exists('$(_HyperUuidStaticLibrary)')"></_HyperUuidStaticLibrary>
  </PropertyGroup>

  <ItemGroup Condition="'$(_HyperUuidStaticLibrary)' != '' And '$(_HyperUuidNet10Unsupported)' == ''">
    <DirectPInvoke Include="hyperuuid" />
    <NativeLibrary Include="$(_HyperUuidStaticLibrary)" />
  </ItemGroup>

  <!-- With the core linked in, the shared library is dead weight in the publish directory:
       nothing opens it. It gets there two ways — NuGet's runtimes/{rid}/native/ asset for a
       package consumer, a copy-to-output item for a project reference — and both end up in
       @(ResolvedFileToPublish), which is where it is taken back out. By file name, since
       that is all the two routes have in common; the managed assembly is HyperUuid.Managed.dll
       and is not in an AOT publish anyway. -->
  <Target Name="_HyperUuidDropSharedLibraryFromAotPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(_HyperUuidStaticLibrary)' != '' And '$(_HyperUuidNet10Unsupported)' == ''">
    <ItemGroup>
      <_HyperUuidSharedLibrary Include="@(ResolvedFileToPublish)"
                         Condition="'%(Filename)%(Extension)' == 'libhyperuuid.so' Or '%(Filename)%(Extension)' == 'libhyperuuid.dylib' Or '%(Filename)%(Extension)' == 'hyperuuid.dll'" />
      <ResolvedFileToPublish Remove="@(_HyperUuidSharedLibrary)" />
    </ItemGroup>
  </Target>
</Project>
