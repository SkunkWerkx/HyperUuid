<Project>
  <!-- Auto-imported into every consuming project via NuGet's build/{tfm}/{PackageId}.targets
       convention — a .targets file (not .props) specifically because it needs
       $(RuntimeIdentifier) already resolved, which for a Blazor WebAssembly project only
       happens after that project's own Sdk.targets import; a .props file (imported before the
       project body) would run too early to see it.

       This is the piece that makes WASM support genuinely zero-effort for a consumer: without
       it, NuGet's runtimes/browser-wasm/nativeassets/{tfm}/ package convention is real (see
       NuGet.Client's ManagedCodeConventions.cs — the "NativeLibraries" PatternSet), and the
       WASM SDK's own WasmApp.Common.targets really does auto-promote any @(NativeLibrary) item
       into @(NativeFileReference) — but restore doesn't actually populate @(NativeLibrary) from
       a plain PackageReference's nativeassets folder the way it does runtimes/{rid}/native/ for
       ordinary P/Invoke. Verified empirically: without this file, the browser-wasm build
       succeeds but throws DllNotFoundException("*") at runtime — the native code never
       actually got linked in. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../runtimes/browser-wasm/nativeassets/net8.0/libhyperuuid.a" />
  </ItemGroup>
</Project>
