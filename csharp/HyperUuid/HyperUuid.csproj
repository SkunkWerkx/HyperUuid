<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>HyperUuid</PackageId>
    <!-- Windows filesystems are case-insensitive: the managed assembly's default filename
         (HyperUuid.dll, from the project name) and the native library's filename
         (hyperuuid.dll, from [LibraryImport("hyperuuid")]'s auto-resolution) differ only by
         case, so on Windows one silently overwrites the other in the shared output directory
         — one gets loaded fine, it's just the wrong one (EntryPointNotFoundException, not
         DllNotFoundException). Linux/macOS never hit this: their native filenames
         (libhyperuuid.so/.dylib) don't collide with HyperUuid.dll even case-sensitively.
         RootNamespace kept explicit so this rename doesn't shift the default namespace. -->
    <AssemblyName>HyperUuid.Managed</AssemblyName>
    <RootNamespace>HyperUuid</RootNamespace>
    <Description>RFC 9562 UUID v4/v5/v6/v7 generation — high-performance, allocation-free, AOT/trim-friendly P/Invoke bindings straight into a native Rust core (libhyperuuid). No runtime bridge, no reflection.</Description>
    <Authors>Brian Buvinghausen</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SkunkWerkx/HyperUuid</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Source-generated LibraryImport P/Invoke only, no reflection anywhere in this assembly:
         opts into (and fails the build on) the trim and Native AOT analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shows up as the package page's description on GitHub Packages/NuGet — sourced from
         csharp/README.md (this project's own, not the repo root's) so the exact same content
         that lives in the repo also ships inside the .nupkg. -->
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <!-- Standard NuGet RID-specific native asset layout (what a real consumer of the packed
         .nupkg gets) — whatever RID(s) happen to be present under runtimes/ at build time. -->
    <None Include="runtimes/**" Pack="true" PackagePath="runtimes" CopyToOutputDirectory="PreserveNewest" />
    <!-- Every native file also copied straight to the output root, flattened: a plain in-repo
         ProjectReference (as used by HyperUuid.Tests) doesn't get the deps.json-driven
         runtimes/{RID}/native probing that only kicks in for an actual consumed NuGet package,
         but every native library load DOES probe the assembly's own directory. Platform-generic
         on purpose — CI runs this same project on 5 different RIDs, each with only its own
         single native file present, so this can't be hardcoded to one of them. -->
    <None Include="runtimes/**/native/*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
