<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>HyperUuid</PackageId>
    <!-- The real, committed version — same story as rust/Cargo.toml's manual bump: 0.0.1
         proved the nuget.org Trusted Publishing leg for real (no local test path exists for
         it); 0.0.2 re-proved it with Source Link / Deterministic / symbol-package health
         fixes applied; 0.0.3 was the first tag-triggered publish through the
         publish-from-CI-artifacts pipeline (find-ci-run in release.yml); 0.0.4 re-proved the
         whole chain again against the net10.0 floor (see the WASM section of this project's
         own README.md for why net8.0 doesn't work) — but shipped a broken build/net10.0/
         HyperUuid.targets: its own comment quoted a wasm-opt flag containing two adjacent
         hyphens, which an XML comment can never contain anywhere in its body, so every real
         WASM consumer's build failed with MSB4024 before even reaching the
         DllNotFoundException/EmccExportedFunction fix that version existed to ship. Only
         caught by actually pulling 0.0.4 from live nuget.org into a fresh scratch project —
         the local test package built earlier in the same session predated that comment edit,
         so it never exercised the broken text. 0.0.5 re-verifies the exact same way (fresh
         scratch project, real headless-Chromium session) before tagging.
         nuget-org-pack packs this as-is, no CI-side override, ahead of the coordinated
         v0.1.0 release. -->
    <Version>0.0.5</Version>
    <!-- Windows filesystems are case-insensitive: the managed assembly's default filename
         (HyperUuid.dll, from the project name) and the native library's filename
         (hyperuuid.dll, from [LibraryImport("hyperuuid")]'s auto-resolution) differ only by
         case, so on Windows one silently overwrites the other in the shared output directory
         — one gets loaded fine, it's just the wrong one (EntryPointNotFoundException, not
         DllNotFoundException). Linux/macOS never hit this: their native filenames
         (libhyperuuid.so/.dylib) don't collide with HyperUuid.dll even case-sensitively.
         RootNamespace kept explicit so this rename doesn't shift the default namespace. -->
    <AssemblyName>HyperUuid.Managed</AssemblyName>
    <RootNamespace>HyperUuid</RootNamespace>
    <Description>RFC 9562 UUID v4/v5/v6/v7 generation — high-performance, allocation-free, AOT/trim-friendly P/Invoke bindings straight into a native Rust core (libhyperuuid). No runtime bridge, no reflection.</Description>
    <Authors>Brian Buvinghausen</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SkunkWerkx/HyperUuid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SkunkWerkx/HyperUuid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>uuid;guid;rfc9562;identifier;pinvoke;native-aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NuGet Package Explorer's "Health" checks (Source Link, Deterministic, Compiler
         Flags). No Microsoft.SourceLink.GitHub PackageReference needed — confirmed (not
         assumed) that the .NET SDK bundles Source Link support for GitHub and every other
         major provider by default; referencing the package explicitly would only override
         the SDK's own bundled version. ContinuousIntegrationBuild is gated on GITHUB_ACTIONS
         so it only kicks in for real CI builds — a local build still gets local-path debug
         info, which is actively useful when developing. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Source-generated LibraryImport P/Invoke only, no reflection anywhere in this assembly:
         opts into (and fails the build on) the trim and Native AOT analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Second build of this exact source, invoked separately (e.g. `dotnet build
       -p:RuntimeIdentifier=browser-wasm -p:BaseOutputPath=bin-browser/`) to produce the
       browser-wasm-specific assembly variant: UuidGenerator.cs's BROWSER-gated
       NativeLibraryName switches from "hyperuuid" (dlopen — every real native platform) to
       "*" (resolve against the current module — the only thing that works for a
       statically-linked WASM native, which has no separate module to dlopen). This output
       gets copied to runtimes/browser-wasm/lib/net10.0/ before packing (see
       hyper-pack-nuget.yml) — NuGet's own asset selection picks it automatically for any
       consumer building with RuntimeIdentifier=browser-wasm, falling back to the default
       build under plain lib/net10.0/ for every other RID, with zero action needed from a
       consumer either way. Keyed off the real, standard RuntimeIdentifier property (the
       same pattern used for wasi-wasm elsewhere in the .NET ecosystem), not a bespoke
       project-specific property — this repo doesn't treat WASM as optional or spike-only
       for C# anymore, so there's no reason for the toggle to be project-specific either.
       See UuidGenerator.cs's own remarks and the README's WebAssembly (Blazor) section for
       the full story. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <DefineConstants>$(DefineConstants);BROWSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tells the platform compatibility analyzer (CA1416 family) this project claims browser
         support, so it flags any BCL call this assembly makes that's marked
         [UnsupportedOSPlatform("browser")] or excluded from a browser allow-list. Cheap,
         static, no toolchain install required — checked clean (zero warnings) against the
         real managed surface below. -->
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shows up as the package page's description on GitHub Packages/NuGet — sourced from
         csharp/README.md (this project's own, not the repo root's) so the exact same content
         that lives in the repo also ships inside the .nupkg. -->
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <!-- Standard NuGet RID-specific native asset layout (what a real consumer of the packed
         .nupkg gets) — whatever RID(s) happen to be present under runtimes/ at build time,
         including runtimes/browser-wasm/lib/net10.0/ (the BROWSER-defined build of this same
         assembly) and runtimes/browser-wasm/nativeassets/net10.0/ (the Rust core's
         wasm32-unknown-emscripten staticlib) placed there before packing — see
         hyper-pack-nuget.yml. -->
    <None Include="runtimes/**" Pack="true" PackagePath="runtimes" CopyToOutputDirectory="PreserveNewest" />
    <!-- Every native file also copied straight to the output root, flattened: a plain in-repo
         ProjectReference (as used by HyperUuid.Tests) doesn't get the deps.json-driven
         runtimes/{RID}/native probing that only kicks in for an actual consumed NuGet package,
         but every native library load DOES probe the assembly's own directory. Platform-generic
         on purpose — CI runs this same project on 5 different RIDs, each with only its own
         single native file present, so this can't be hardcoded to one of them. Deliberately
         doesn't match runtimes/browser-wasm/nativeassets/ (different folder name, "nativeassets"
         not "native") — that asset needs the real NativeFileReference wiring below, not a flat
         copy; nothing loads it via dlopen. -->
    <None Include="runtimes/**/native/*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Auto-imported into every consuming project via NuGet's build/{tfm}/{PackageId}.targets
         convention — see the file itself for why this is required at all (NuGet's
         runtimes/{rid}/nativeassets/ package convention is real, and the WASM SDK really does
         auto-promote @(NativeLibrary) into @(NativeFileReference), but restore doesn't
         populate @(NativeLibrary) from a plain PackageReference's nativeassets folder the way
         it does runtimes/{rid}/native/ for ordinary P/Invoke — verified empirically, not
         assumed). Without this file, a real NuGet consumer's browser-wasm build succeeds but
         throws DllNotFoundException("*") at runtime. -->
    <None Include="build/**" Pack="true" PackagePath="build" />
  </ItemGroup>

</Project>
