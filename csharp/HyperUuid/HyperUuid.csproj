<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>HyperUuid</PackageId>
    <!-- The committed version prepare-release.yml bumps — the same single mechanical sweep
         that keeps every binding's manifest in lockstep with rust/Cargo.toml. Packed as-is,
         no CI-side override; UuidGenerator.NativeVersion reports the core's own, so a test
         pins the two together. -->
    <Version>0.8.0</Version>
    <!-- Windows filesystems are case-insensitive: the managed assembly's default filename
         (HyperUuid.dll, from the project name) and the native library's filename
         (hyperuuid.dll, from [LibraryImport("hyperuuid")]'s auto-resolution) differ only by
         case, so on Windows one silently overwrites the other in the shared output directory
         — one gets loaded fine, it's just the wrong one (EntryPointNotFoundException, not
         DllNotFoundException). Linux/macOS never hit this: their native filenames
         (libhyperuuid.so/.dylib) don't collide with HyperUuid.dll even case-sensitively.
         RootNamespace kept explicit so this rename doesn't shift the default namespace. -->
    <AssemblyName>HyperUuid.Managed</AssemblyName>
    <RootNamespace>HyperUuid</RootNamespace>
    <Description>RFC 9562 UUID v4/v5/v6/v7 generation — high-performance, allocation-free, AOT/trim-friendly P/Invoke bindings straight into a native Rust core (libhyperuuid). No runtime bridge, no reflection.</Description>
    <Authors>Brian Buvinghausen</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SkunkWerkx/HyperUuid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SkunkWerkx/HyperUuid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>uuid;guid;rfc9562;identifier;pinvoke;native-aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NuGet Package Explorer's "Health" checks (Source Link, Deterministic, Compiler
         Flags). No Microsoft.SourceLink.GitHub PackageReference needed — confirmed (not
         assumed) that the .NET SDK bundles Source Link support for GitHub and every other
         major provider by default; referencing the package explicitly would only override
         the SDK's own bundled version. ContinuousIntegrationBuild is gated on GITHUB_ACTIONS
         so it only kicks in for real CI builds — a local build still gets local-path debug
         info, which is actively useful when developing. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Source-generated LibraryImport P/Invoke only, no reflection anywhere in this assembly:
         opts into (and fails the build on) the trim and Native AOT analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Ships the .xml doc file inside the .nupkg (NuGet's own PackageId.xml convention) so
         IntelliSense/Rider/etc. show every method's real doc comment for a consumer, not just
         its signature. Every P/Invoke declaration below is private, so CS1591 (missing XML
         comment on a publicly visible member) only ever fires on this binding's real public
         surface — which is exactly what TreatWarningsAsErrors is here to enforce: an
         undocumented public member fails the build instead of silently shipping undocumented. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tells the platform compatibility analyzer (CA1416 family) this project claims browser
         support, so it flags any BCL call this assembly makes that's marked
         [UnsupportedOSPlatform("browser")] or excluded from a browser allow-list. Cheap,
         static, no toolchain install required — checked clean (zero warnings) against the
         real managed surface below. -->
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shows up as the package page's description on GitHub Packages/NuGet — sourced from
         csharp/README.md (this project's own, not the repo root's) so the exact same content
         that lives in the repo also ships inside the .nupkg. -->
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <!-- MSBuild item globs reach outside the project directory freely, so this one takes the
         repo root's LICENSE directly — no local copy needed, unlike the gem and the wheel,
         whose packers both refuse a parent path. PackageLicenseExpression above stays the
         machine-readable license (nuget.org renders the page from it); this ships the actual
         text alongside it, which the expression alone doesn't do. -->
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <!-- Standard NuGet RID-specific native asset layout (what a real consumer of the packed
         .nupkg gets) — whatever RID(s) happen to be present under runtimes/ at build time.
         No runtimes/browser-wasm/lib/ asset needed anymore: one compiled assembly now covers
         every platform (see UuidGenerator.cs's own remarks), so NuGet's plain lib/net10.0/
         fallback already is the browser-wasm build. Only
         runtimes/browser-wasm/nativeassets/net10.0/ (the Rust core's wasm32-unknown-emscripten
         staticlib) is RID-specific here, placed there before packing — see
         hyper-pack-nuget.yml. -->
    <None Include="runtimes/**" Pack="true" PackagePath="runtimes" CopyToOutputDirectory="PreserveNewest" />
    <!-- Every native file also copied straight to the output root, flattened: a plain in-repo
         ProjectReference (as used by HyperUuid.Tests) doesn't get the deps.json-driven
         runtimes/{RID}/native probing that only kicks in for an actual consumed NuGet package,
         but every native library load DOES probe the assembly's own directory. Platform-generic
         on purpose — CI runs this same project on five of the six desktop RIDs the package carries
         (every one but osx-x64, which is cross-built and has no CI leg) and the two musl ones,
         linux-musl-x64 and linux-musl-arm64, each leg with only its own single native file
         present, so this can't be hardcoded to one of them.
         Deliberately doesn't match runtimes/browser-wasm/nativeassets/ (different folder name,
         "nativeassets" not "native") — that asset needs the real NativeFileReference wiring
         below, not a flat copy; nothing loads it via dlopen.

         Two spellings of the one copy, because flattening is only safe for a single RID: once
         more than one is staged (the pack job stages all of them, and a dev box can easily
         hold a glibc and a musl build side by side), libhyperuuid.so from linux-x64,
         linux-arm64 and both musl RIDs all flatten to the same output filename and whichever
         copies last wins. So when this SDK's own RID is among the staged ones, only that one
         is flattened — on Alpine the SDK's RID is linux-musl-x64, so the musl build is the one
         that lands; everything-flattened stays the fallback for a leg whose SDK RID differs
         from the one RID it staged. -->
    <None Include="runtimes/$(NETCoreSdkRuntimeIdentifier)/native/*"
          Condition="Exists('runtimes/$(NETCoreSdkRuntimeIdentifier)/native')"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes/**/native/*"
          Condition="!Exists('runtimes/$(NETCoreSdkRuntimeIdentifier)/native')"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Auto-imported into every consuming project via NuGet's build/{PackageId}.targets
         convention, and into projects that reach the package through another project via
         buildTransitive/ — see the file itself for why this is required at all (NuGet's
         runtimes/{rid}/nativeassets/ package convention is real, and the WASM SDK really does
         auto-promote @(NativeLibrary) into @(NativeFileReference), but restore doesn't
         populate @(NativeLibrary) from a plain PackageReference's nativeassets folder the way
         it does runtimes/{rid}/native/ for ordinary P/Invoke — verified empirically, not
         assumed). Without this file, a real NuGet consumer's browser-wasm build succeeds but
         throws DllNotFoundException("*") at runtime. -->
    <None Include="build/**" Pack="true" PackagePath="build" />
    <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive" />
    <!-- The core as a static library, one per RID: for a Native AOT publish to link in
         instead of loading the shared library, and for an iOS or Mac Catalyst app, which
         can only link it. build/HyperUuid.targets has the wiring and the reasons. Staged
         here before packing, like runtimes/, and not committed. -->
    <None Include="staticlibs/**" Pack="true" PackagePath="staticlibs" />
    <!-- Local dev loop, the same one HyperCast's csproj carries: when the Rust core has been
         built in-repo (`cargo cdylib` in rust/), copy that fresh native library
         straight to the output so tests and benchmarks run against it without any packaging
         step. CI's runtimes/ layout above takes over for real packages; both patterns copy to
         the output root, where native library resolution always probes.

         Only when this SDK's own RID has NOT been placed under runtimes/ explicitly. Both
         items link to the same output filename, and PreserveNewest lets the newer one win —
         which in CI would be the wrong one, since cargo runs in the same job before the C#
         leg does. Explicit placement is the signal that someone else already staged the
         right bytes. The RID test also keeps the two C libraries apart: on Alpine the SDK's
         RID is linux-musl-x64, so a staged musl build is never displaced by whatever sits in
         rust/target/release. -->
    <None Include="../../rust/target/release/libhyperuuid.so"
          Condition="Exists('../../rust/target/release/libhyperuuid.so') And !Exists('runtimes/$(NETCoreSdkRuntimeIdentifier)/native/libhyperuuid.so')"
          Link="libhyperuuid.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../../rust/target/release/libhyperuuid.dylib"
          Condition="Exists('../../rust/target/release/libhyperuuid.dylib') And !Exists('runtimes/$(NETCoreSdkRuntimeIdentifier)/native/libhyperuuid.dylib')"
          Link="libhyperuuid.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../../rust/target/release/hyperuuid.dll"
          Condition="Exists('../../rust/target/release/hyperuuid.dll') And !Exists('runtimes/$(NETCoreSdkRuntimeIdentifier)/native/hyperuuid.dll')"
          Link="hyperuuid.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
