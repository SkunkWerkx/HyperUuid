@page "/"
@using HyperUuid

<PageTitle>@Title</PageTitle>

<h1>HyperUuid WASM smoke test</h1>

<pre id="results">@Results</pre>

@code {
    private string Title = "RUNNING";
    private string Results = "running...";

    protected override void OnInitialized()
    {
        var lines = new List<string>();
        var failed = false;

        void Fail(string msg)
        {
            failed = true;
            lines.Add($"FAIL: {msg}");
        }

        // Every call goes through the public UuidGenerator surface a Blazor consumer uses and
        // lands in the statically linked wasm module via LibraryImport("*"), so an entry point
        // missing from build/HyperUuid.targets' EmccExportedFunction list fails here at
        // runtime, not at the link. That only holds for an entry point this page actually
        // calls, so it calls all nineteen: the eighteen uuid_* functions and hyperuuid_version.
        try
        {
            // The probe must name the core that actually linked in. First, because it is the
            // one call that reports a missing export as false rather than throwing.
            if (!UuidGenerator.IsAvailable || UuidGenerator.NativeVersion is null)
                Fail($"native probe: available={UuidGenerator.IsAvailable} version={UuidGenerator.NativeVersion}");
            else
                lines.Add($"ok   native: version={UuidGenerator.NativeVersion}");

            var a = UuidGenerator.NewV4();
            var b = UuidGenerator.NewV4();
            if (a == b) Fail("two v4 calls produced identical output");
            else lines.Add($"ok   v4: {a} {b}");

            var v5 = UuidGenerator.NewV5(UuidGenerator.Namespaces.Dns, "www.example.com");
            var expectedV5 = new Guid("2ed6657d-e927-568b-95e1-2665a8aea6a2");
            if (v5 != expectedV5) Fail($"v5 mismatch, got {v5}, expected {expectedV5}");
            else lines.Add($"ok   v5: {v5} matches RFC 9562 Appendix A.4 vector");

            const long fixedMs = 1_645_557_742_000L;
            var v6 = UuidGenerator.NewV6(fixedMs);
            if (UuidGenerator.V6UnixMillis(v6) != fixedMs) Fail($"v6 fixed-timestamp mismatch for {v6}");
            else lines.Add($"ok   v6 (fixed): {v6} embeds timestamp {fixedMs}");

            var v7 = UuidGenerator.NewV7(fixedMs);
            if (UuidGenerator.V7UnixMillis(v7) != fixedMs) Fail($"v7 fixed-timestamp mismatch for {v7}");
            else lines.Add($"ok   v7 (fixed): {v7} embeds timestamp {fixedMs}");

            // Real-clock v7: proves DateTimeOffset.UtcNow works inside this wasm host at all.
            var before = DateTimeOffset.UtcNow;
            var now = UuidGenerator.NewV7();
            var after = DateTimeOffset.UtcNow;
            var nowMs = UuidGenerator.V7UnixMillis(now);
            if (nowMs < before.AddSeconds(-2).ToUnixTimeMilliseconds() || nowMs > after.AddSeconds(2).ToUnixTimeMilliseconds())
                Fail($"v7 real-clock timestamp {nowMs} not within 2s of wall clock [{before:O}, {after:O}]");
            else
                lines.Add($"ok   v7 (now): {now} embeds real clock timestamp {nowMs}");

            // Batch crossing: one native call fills 1000 ids, strictly increasing within a millisecond.
            var batch = UuidGenerator.NewV7Batch(1000, fixedMs);
            var increasing = true;
            for (var i = 1; i < batch.Length; i++)
                if (batch[i].CompareTo(batch[i - 1]) == 0 || UuidGenerator.V7UnixMillis(batch[i]) != fixedMs) increasing = false;
            if (batch.Length != 1000 || !increasing) Fail("v7 batch is not 1000 distinct ids at the requested timestamp");
            else lines.Add("ok   v7 batch: 1000 distinct ids at the requested timestamp");

            // The v6 batch is its own entry point, in both destination shapes.
            var v6Batch = UuidGenerator.NewV6Batch(1000, fixedMs);
            var v6Raw = new byte[4 * 16];
            UuidGenerator.FillV6(v6Raw, fixedMs);
            if (v6Batch.Distinct().Count() != 1000
                || v6Batch.Any(id => UuidGenerator.V6UnixMillis(id) != fixedMs)
                || UuidGenerator.V6UnixMillis(new Guid(v6Raw.AsSpan(3 * 16, 16), bigEndian: true)) != fixedMs)
                Fail("v6 batch is not 1000 distinct ids at the requested timestamp");
            else
                lines.Add("ok   v6 batch: 1000 distinct ids at the requested timestamp");

            // The four SQL-order entry points: to and back, per version, with the raw-byte form
            // agreeing with the Guid form on the way out.
            var v7Bytes = new byte[16];
            v7.TryWriteBytes(v7Bytes, bigEndian: true, out _);
            UuidGenerator.V7ToSqlOrder(v7Bytes);
            var v7Sql = UuidGenerator.V7ToSqlOrder(v7);
            if (v7Sql == v7 || !v7Bytes.AsSpan().SequenceEqual(v7Sql.ToByteArray()) || UuidGenerator.V7FromSqlOrder(v7Sql) != v7)
                Fail($"v7 SQL order does not round-trip for {v7}");
            else
                lines.Add($"ok   v7 SQL order: {v7Sql} round-trips");

            var v6Bytes = new byte[16];
            v6.TryWriteBytes(v6Bytes, bigEndian: true, out _);
            UuidGenerator.V6ToSqlOrder(v6Bytes);
            var v6Sql = UuidGenerator.V6ToSqlOrder(v6);
            if (v6Sql == v6 || !v6Bytes.AsSpan().SequenceEqual(v6Sql.ToByteArray()) || UuidGenerator.V6FromSqlOrder(v6Sql) != v6)
                Fail($"v6 SQL order does not round-trip for {v6}");
            else
                lines.Add($"ok   v6 SQL order: {v6Sql} round-trips");

            // Inspection and the layout-aware reads: uuid_version, uuid_variant, uuid_is_rfc
            // and both uuid_v*_unix_millis_in, the last two on SQL-ordered values in place.
            if (UuidGenerator.Version(v7) != 7 || UuidGenerator.Variant(v7) != UuidVariant.Rfc9562
                || !UuidGenerator.IsRfc(v7Sql, 7, UuidLayout.SqlServer) || UuidGenerator.Version(v6Sql, UuidLayout.SqlServer) != 6
                || UuidGenerator.V7UnixMillis(v7Sql, UuidLayout.SqlServer) != UuidGenerator.V7UnixMillis(v7)
                || UuidGenerator.V6UnixMillis(v6Sql, UuidLayout.SqlServer) != UuidGenerator.V6UnixMillis(v6)
                || UuidGenerator.GetTimestamp(v7Sql, UuidLayout.SqlServer) != UuidGenerator.V7Timestamp(v7))
                Fail($"inspection disagrees for {v7} / {v6}");
            else
                lines.Add("ok   inspection: version, variant, IsRfc and SQL-layout timestamps agree");
        }
        catch (Exception ex)
        {
            Fail($"exception: {ex}");
        }

        lines.Add("");
        lines.Add(failed ? "SOME WASM CHECKS FAILED" : "ALL WASM CHECKS PASSED");
        Results = string.Join("\n", lines);
        Title = failed ? "FAIL" : "PASS";
    }
}
