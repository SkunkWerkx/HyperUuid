@page "/"
@using HyperUuid

<PageTitle>@Title</PageTitle>

<h1>HyperUuid WASM smoke test</h1>

<pre id="results">@Results</pre>

@code {
    private string Title = "RUNNING";
    private string Results = "running...";

    protected override void OnInitialized()
    {
        var lines = new List<string>();
        var failed = false;

        void Fail(string msg)
        {
            failed = true;
            lines.Add($"FAIL: {msg}");
        }

        // Every call goes through the public UuidGenerator surface a Blazor consumer uses and
        // lands in the statically linked wasm module via LibraryImport("*"), so an entry point
        // missing from build/net10.0/HyperUuid.targets' EmccExportedFunction list fails here at
        // runtime, not at the link.
        try
        {
            var a = UuidGenerator.NewV4();
            var b = UuidGenerator.NewV4();
            if (a == b) Fail("two v4 calls produced identical output");
            else lines.Add($"ok   v4: {a} {b}");

            var v5 = UuidGenerator.NewV5(UuidGenerator.Namespaces.Dns, "www.example.com");
            var expectedV5 = new Guid("2ed6657d-e927-568b-95e1-2665a8aea6a2");
            if (v5 != expectedV5) Fail($"v5 mismatch, got {v5}, expected {expectedV5}");
            else lines.Add($"ok   v5: {v5} matches RFC 9562 Appendix A.4 vector");

            const long fixedMs = 1_645_557_742_000L;
            var v6 = UuidGenerator.NewV6(fixedMs);
            if (UuidGenerator.V6UnixMillis(v6) != fixedMs) Fail($"v6 fixed-timestamp mismatch for {v6}");
            else lines.Add($"ok   v6 (fixed): {v6} embeds timestamp {fixedMs}");

            var v7 = UuidGenerator.NewV7(fixedMs);
            if (UuidGenerator.V7UnixMillis(v7) != fixedMs) Fail($"v7 fixed-timestamp mismatch for {v7}");
            else lines.Add($"ok   v7 (fixed): {v7} embeds timestamp {fixedMs}");

            // Real-clock v7: proves DateTimeOffset.UtcNow works inside this wasm host at all.
            var before = DateTimeOffset.UtcNow;
            var now = UuidGenerator.NewV7();
            var after = DateTimeOffset.UtcNow;
            var nowMs = UuidGenerator.V7UnixMillis(now);
            if (nowMs < before.AddSeconds(-2).ToUnixTimeMilliseconds() || nowMs > after.AddSeconds(2).ToUnixTimeMilliseconds())
                Fail($"v7 real-clock timestamp {nowMs} not within 2s of wall clock [{before:O}, {after:O}]");
            else
                lines.Add($"ok   v7 (now): {now} embeds real clock timestamp {nowMs}");

            // Batch crossing: one native call fills 1000 ids, strictly increasing within a millisecond.
            var batch = UuidGenerator.NewV7Batch(1000, fixedMs);
            var increasing = true;
            for (var i = 1; i < batch.Length; i++)
                if (batch[i].CompareTo(batch[i - 1]) == 0 || UuidGenerator.V7UnixMillis(batch[i]) != fixedMs) increasing = false;
            if (batch.Length != 1000 || !increasing) Fail("v7 batch is not 1000 distinct ids at the requested timestamp");
            else lines.Add("ok   v7 batch: 1000 distinct ids at the requested timestamp");
        }
        catch (Exception ex)
        {
            Fail($"exception: {ex}");
        }

        lines.Add("");
        lines.Add(failed ? "SOME WASM CHECKS FAILED" : "ALL WASM CHECKS PASSED");
        Results = string.Join("\n", lines);
        Title = failed ? "FAIL" : "PASS";
    }
}
