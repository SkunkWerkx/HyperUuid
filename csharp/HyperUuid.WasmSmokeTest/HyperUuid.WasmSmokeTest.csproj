<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <!-- Both frameworks the package serves in the browser, published one at a time (check.sh
       passes -f). check.sh serves the publish output statically, so neither needs a dev
       server; the Gateway package, the static web assets host .NET 11's template adds, stays
       on net11.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.*-*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.*-*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The managed binding, through its real public surface: this app declares no P/Invokes
         of its own, because UuidGenerator declares every entry point twice (hyperuuid for
         dlopen platforms, and * for the statically linked wasm module) and picks at the call
         site with OperatingSystem.IsBrowser(). -->
    <ProjectReference Include="../HyperUuid/HyperUuid.csproj" />
  </ItemGroup>

  <!-- What a NuGet consumer gets for free and a ProjectReference does not: the package's
       build/net10.0/HyperUuid.targets is only auto-imported from a restored package. Importing
       it by hand means this app links through the shipped NativeFileReference wiring rather
       than a copy of it, so an archive that is not linked fails here at the link exactly as it
       would for a real Blazor consumer.

       Needs the wasm32-unknown-emscripten staticlib staged where the targets file looks for
       it, csharp/HyperUuid/runtimes/browser-wasm/nativeassets/net11.0/libhyperuuid.a, which
       is gitignored like every other runtimes/ asset. check.sh stages it. -->
  <Import Project="../HyperUuid/build/net10.0/HyperUuid.targets" />

</Project>
