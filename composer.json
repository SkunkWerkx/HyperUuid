{
    "name": "skunkwerkx/hyperuuid",
    "description": "RFC 9562 UUID v4/v5/v6/v7 generation — direct native FFI into a Rust core, no runtime bridge.",
    "type": "library",
    "keywords": ["uuid", "guid", "rfc9562", "uuidv4", "uuidv5", "uuidv6", "uuidv7", "ffi", "rust"],
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Buvinghausen"
        }
    ],
    "homepage": "https://github.com/SkunkWerkx/HyperUuid",
    "support": {
        "issues": "https://github.com/SkunkWerkx/HyperUuid/issues",
        "source": "https://github.com/SkunkWerkx/HyperUuid"
    },
    "require": {
        "php": ">=8.2",
        "ext-ffi": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpbench/phpbench": "^1.7",
        "ramsey/uuid": "^4.9",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "HyperUuid\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HyperUuid\\Tests\\": "php/tests/",
            "HyperUuid\\Bench\\": "php/bench/"
        }
    }
}
