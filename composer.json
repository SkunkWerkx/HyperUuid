{
    "name": "skunkwerkx/hyperuuid",
    "description": "RFC 9562 UUID v4/v5/v7 generation, with a version 8 SQL Server order — a PHP extension over a Rust core, installed with PIE.",
    "type": "php-ext",
    "keywords": ["uuid", "guid", "rfc9562", "uuidv4", "uuidv5", "uuidv7", "extension", "rust"],
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Buvinghausen"
        }
    ],
    "homepage": "https://github.com/SkunkWerkx/HyperUuid",
    "support": {
        "issues": "https://github.com/SkunkWerkx/HyperUuid/issues",
        "source": "https://github.com/SkunkWerkx/HyperUuid"
    },
    "require": {
        "php": ">=8.3"
    },
    "php-ext": {
        "extension-name": "hyperuuid",
        "support-nts": true,
        "support-zts": false,
        "download-url-method": ["pre-packaged-binary"],
        "os-families": ["linux", "darwin", "windows"]
    }
}
